# HoneyChain Environment Variables

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (PostgreSQL, Auth, Storage)
# Free Tier credentials from https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Direct Connection (for Drizzle ORM migrations and server queries)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# Blockchain Network (Arbitrum Sepolia L2 Testnet - Free / ₹0)
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Optional Alchemy RPC endpoint for higher reliability (Free tier: 30M CU/mo)
# NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/your-alchemy-api-key

# Smart Contracts
# Deployed contract addresses on Arbitrum Sepolia
NEXT_PUBLIC_REGISTRY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ACCESS_CONTROL_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional Demo Sponsor Relayer Private Key (Only used for testnet demo evaluations)
# NEVER put mainnet keys or real funds here. Use only a dedicated testnet address funded with free faucet ETH.
DEMO_SPONSOR_PRIVATE_KEY=

